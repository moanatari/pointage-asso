@page
@model Pointage.Pages.Admin.KiosksModel
@{
    ViewData["Title"] = "Bornes";
}
<h1>Bornes</h1>
@foreach (var n in Model.PublicNetworks)
{
    <div class="box error">
        <p>Le réseau « @n » est en profil <strong>Public</strong> : le pare-feu bloque les bornes qui passent par ce réseau. Passez-le en <strong>Privé</strong> (Paramètres &gt; Réseau et Internet &gt; propriétés du réseau). <a href="/Aide/Bornes">Aide &gt; Bornes</a></p>
    </div>
}
<p>Adresse à saisir sur la borne :</p>
<ul>
    @foreach (var u in Model.Urls)
    {
        <li><strong>@u</strong>@(u == Model.UrlByName ? " (depuis un PC Windows uniquement)" : "")</li>
    }
</ul>
<p>Réservez l'adresse IP du poste dans la box pour qu'elle ne change pas.</p>
<div class="box">
    <h2>Mettre la borne en mode kiosque</h2>
    <p>Affichez la borne en plein écran, sans pouvoir quitter la page. Procédure pour Windows, Android et iPad : <a href="/Aide/Bornes#kiosque">Aide &gt; Bornes</a>. Script Windows : <a href="/static/borne-kiosque.ps1">borne-kiosque.ps1</a>.</p>
</div>
@if (Model.Code is not null)
{
    <p>Saisissez ce code sur la borne (adresse <strong>@Model.Urls[0]</strong>) :</p>
    <p class="pairing-code">@Model.Code</p>
    <p>Valable jusqu'à @Model.CodeExpiresAt.ToString("HH:mm"), une seule fois.</p>
}
<form method="post" asp-page-handler="Pair" class="stack">
    @if (Model.Error is not null)
    {
        <p class="error">@Model.Error</p>
    }
    <label>Nom de la borne <input asp-for="KioskName" placeholder="Ex. : Entrée" required></label>
    <button type="submit">Lier une borne</button>
</form>

<h2>Bornes liées</h2>
@if (Model.Kiosks.Count == 0)
{
    <p>Aucune borne liée.</p>
}
else
{
    <table>
        <thead><tr><th>Nom</th><th>Liée le</th><th>État</th><th></th></tr></thead>
        <tbody>
        @foreach (var k in Model.Kiosks)
        {
            <tr>
                <td>@k.Name</td>
                <td>@k.PairedAt.ToString("dd/MM/yyyy HH:mm")</td>
                @if (k.RevokedAt is { } revoked)
                {
                    <td>Révoquée le @revoked.ToString("dd/MM/yyyy HH:mm")</td>
                    <td></td>
                }
                else
                {
                    <td>Active</td>
                    <td>
                        <form method="post" asp-page-handler="Revoke" asp-route-id="@k.Id">
                            <button type="submit">Révoquer</button>
                        </form>
                    </td>
                }
            </tr>
        }
        </tbody>
    </table>
}
