@page
@{
    ViewData["Title"] = "Aide";
}
<h1>Aide</h1>
<p>Guide pour les responsables de Pointage, de l'installation au dépannage.</p>
<ol>
    <li><a href="/Aide/PremiersPas">Premiers pas</a> : l'assistant, le premier compte, les réglages, la première borne.</li>
    <li><a href="/Aide/Quotidien">Au quotidien</a> : valider les arrivées et départs, ajouter ou corriger une présence.</li>
    <li><a href="/Aide/Membres">Membres</a> : ajouter, importer, cartes, anonymisation.</li>
    <li><a href="/Aide/Bornes">Bornes</a> : adresse, liaison, mode kiosque, problèmes de borne.</li>
    <li><a href="/Aide/Historique">Historique et statistiques</a> : périodes, ce qui est compté, export CSV.</li>
    <li><a href="/Aide/Administration">Administration</a> : réglages, port, comptes, journal, purge, mises à jour (super admin).</li>
    <li><a href="/Aide/Depannage">Dépannage et questions fréquentes</a> : mot de passe perdu, port, HTTPS, données et sauvegardes.</li>
</ol>
