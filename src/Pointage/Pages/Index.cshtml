@page
@using Pointage.Presences
@model IndexModel
@{
    ViewData["Title"] = "Accueil";
}
@* Rafraîchissement automatique : les arrivées pointées à la borne apparaissent sans action du responsable. *@
@section Head {
    <meta http-equiv="refresh" content="10;url=/?auto=1">
}
<h1>Accueil</h1>
<p><a href="/Presences/Add">Ajouter une présence</a></p>
<div class="columns">
    <section>
        <h2>À valider (@Model.Pending.Count)</h2>
        @if (Model.Pending.Count > 0)
        {
            <form method="post" asp-page-handler="ValidateAll">
                @foreach (var r in Model.Pending)
                {
                    <input type="hidden" name="ids" value="@r.Presence.Id" />
                }
                <button type="submit">Tout valider</button>
            </form>
        }
        <ul class="plain">
        @foreach (var r in Model.Pending)
        {
            <li>
                <strong>@r.MemberName</strong>@(r.Age is { } age ? $", {age} ans" : "") – @r.Presence.ArrivedAt.ToString("HH:mm")
                <form method="post" asp-page-handler="Validate" asp-route-id="@r.Presence.Id" class="inline"><button type="submit">Valider</button></form>
                <form method="post" asp-page-handler="Refuse" asp-route-id="@r.Presence.Id" class="inline"><button type="submit">Refuser</button></form>
            </li>
        }
        </ul>
    </section>
    @if (Model.DepartureValidation || Model.PendingDepartures.Count > 0)
    {
        <section>
            <h2>Départs à valider (@Model.PendingDepartures.Count)</h2>
            <ul class="plain">
            @foreach (var r in Model.PendingDepartures)
            {
                var left = r.Presence.DepartedAt!.Value;
                <li>
                    <strong>@r.MemberName</strong> – parti @(DateOnly.FromDateTime(left) == Model.Today ? "" : left.ToString("dd/MM") + " ")@left.ToString("HH:mm")
                    <form method="post" asp-page-handler="ValidateDeparture" asp-route-id="@r.Presence.Id" class="inline"><button type="submit">Valider</button></form>
                    <form method="post" asp-page-handler="RefuseDeparture" asp-route-id="@r.Presence.Id" class="inline"><button type="submit">Refuser</button></form>
                </li>
            }
            </ul>
        </section>
    }
    <section>
        <h2>Présents aujourd'hui (@Model.Present.Count)</h2>
        <ul class="plain">
        @foreach (var r in Model.Present)
        {
            <li><a href="/Members/Details/@r.Presence.MemberId">@r.MemberName</a> – arrivé @r.Presence.ArrivedAt.ToString("HH:mm")@(r.Presence.Status == PresenceStatus.Pending ? " (à valider)" : "")@(r.Presence.DepartureStatus == PresenceStatus.Pending ? " (départ à valider)" : "")</li>
        }
        </ul>
    </section>
    <section>
        <h2>Partis aujourd'hui (@Model.Departed.Count)</h2>
        <ul class="plain">
        @foreach (var r in Model.Departed)
        {
            <li><a href="/Members/Details/@r.Presence.MemberId">@r.MemberName</a> – arrivé @r.Presence.ArrivedAt.ToString("HH:mm") – @(r.Presence.DepartedAt is { } d ? $"parti {d:HH:mm}" : "départ non pointé")@(r.Presence.Status == PresenceStatus.Pending ? " (à valider)" : "")</li>
        }
        </ul>
    </section>
</div>
